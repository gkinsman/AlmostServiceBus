<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Path where Host publish output lands before being packed -->
    <HostPublishDir>$(MSBuildThisFileDirectory)obj\host-publish\</HostPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.4.6" />
    <!-- Build the Host project before this one, but don't reference its assembly -->
    <ProjectReference Include="..\AlmostServiceBus.Host\AlmostServiceBus.Host.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!-- .targets file that copies tools/ to consuming project's output -->
  <ItemGroup>
    <None Include="buildTransitive\**\*"
          Pack="true"
          PackagePath="buildTransitive/"
          Visible="false" />
  </ItemGroup>

  <!-- Publish the Host project, then include its output in the NuGet package.
       The Content glob must be inside a target so it runs AFTER publish populates the directory. -->
  <Target Name="PublishHostAndInclude" BeforeTargets="Build;GenerateNuspec">
    <MSBuild Projects="..\AlmostServiceBus.Host\AlmostServiceBus.Host.csproj"
             Targets="Publish"
             Properties="PublishDir=$(HostPublishDir);Configuration=$(Configuration);PublishTrimmed=false;SelfContained=false" />
    <ItemGroup>
      <Content Include="$(HostPublishDir)**\*"
               Pack="true"
               PackagePath="tools/"
               CopyToOutputDirectory="Never"
               Visible="false" />
    </ItemGroup>
  </Target>

</Project>
