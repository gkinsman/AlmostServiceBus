<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AlmostServiceBus.Core\AlmostServiceBus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vite.AspNetCore" Version="2.4.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Dashboard Vue app lives in a sibling directory -->
    <DashboardDir>$(MSBuildThisFileDirectory)..\AlmostServiceBus.Dashboard</DashboardDir>
    <!-- dotnet tool packaging -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>almost-servicebus</ToolCommandName>
    <PackageId>AlmostServiceBus.Tool</PackageId>
  </PropertyGroup>

  <!-- Build the Vue dashboard before the .NET build when wwwroot is missing
       or when building in Release. In Development with an existing wwwroot,
       Vite.AspNetCore proxies to the Vite dev server for hot reload. -->
  <Target Name="BuildDashboard" BeforeTargets="Build"
          Condition="('$(Configuration)' == 'Release' OR !Exists('$(MSBuildThisFileDirectory)wwwroot/index.html')) AND Exists('$(DashboardDir)/package.json')">
    <Exec Command="npm ci --prefix $(DashboardDir)" />
    <Exec Command="npm run build --prefix $(DashboardDir)" />
  </Target>

  <!-- The Host overrides ContentRootPath to AppContext.BaseDirectory so the
       dotnet-tool deployment path works (wwwroot must sit alongside the DLL).
       Microsoft.NET.Sdk.Web's default Static Web Assets pipeline serves wwwroot
       from source, but that doesn't apply once ContentRootPath is overridden —
       so copy wwwroot explicitly into the output directory. -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
