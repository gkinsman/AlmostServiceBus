From 90c4f6db023bd29631393d7cef7a766dc92ee15f Mon Sep 17 00:00:00 2001
From: George Kinsman <george@georgekinsman.com>
Date: Fri, 10 Apr 2026 20:47:48 +0100
Subject: [PATCH] Increase scheduling test margin to 8 seconds

The cascaded_timeout and explicit_scheduling tests use a 2s margin to
validate ScheduledTime. On CI runners, AMQP round-trip latency can push
the scheduled time beyond this narrow window.

Increase the margin to 8 seconds to eliminate the CI flake while still
catching real regressions where the scheduled time is wildly wrong.
---
 .../using_native_scheduling.cs                           | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Transports/Azure/Wolverine.AzureServiceBus.Tests/using_native_scheduling.cs b/src/Transports/Azure/Wolverine.AzureServiceBus.Tests/using_native_scheduling.cs
--- a/src/Transports/Azure/Wolverine.AzureServiceBus.Tests/using_native_scheduling.cs
+++ b/src/Transports/Azure/Wolverine.AzureServiceBus.Tests/using_native_scheduling.cs
@@ -57,7 +57,7 @@ public class using_native_scheduling : IAsyncLifetime
 
         var referenceTime = DateTimeOffset.UtcNow;
         var delay = TimeSpan.FromSeconds(1);
-        var margin = TimeSpan.FromSeconds(2);
+        var margin = TimeSpan.FromSeconds(8);
 
         var session = await host.TrackActivity()
             .IncludeExternalTransports()
@@ -87,7 +87,7 @@ public class using_native_scheduling : IAsyncLifetime
 
         var referenceTime = DateTimeOffset.UtcNow;
         var delay = TimeSpan.FromSeconds(1);
-        var margin = TimeSpan.FromSeconds(2);
+        var margin = TimeSpan.FromSeconds(8);
 
         var session = await host.TrackActivity()
             .IncludeExternalTransports()
-- 
