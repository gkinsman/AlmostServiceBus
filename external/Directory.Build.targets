<Project>

  <!--
    Scoped overrides for external submodule projects. Applied to every csproj
    under `external/`, NOT to the submodules themselves (this file sits one
    directory above every submodule root, so it survives submodule updates).

    Pin System.Security.Cryptography.Xml to a version without the GHSA-37gx-xxp4-5rgx
    / GHSA-w3x6-4m5h-cxqf high-severity advisories. NServiceBus 10.1.0 transitively
    pulls 10.0.2 which is vulnerable — NU1903 (Warning As Error) causes restore to
    fail. Upgrading the transitive via an explicit PackageReference here resolves it
    without forking the submodule's csprojs.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.6" />
  </ItemGroup>

</Project>
